# Copia este archivo como .env y rellena lo que quieras usar. Todo es opcional.

# IA para leer el PDF y proponer platos (una de las dos; sin clave se usa el lector y el recetario locales)
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4.1-mini        # solo para leer el PDF (una vez al mes)
# OPENAI_MODEL_FAST=gpt-5-nano      # para proponer platos e ingredientes (muy barato)
# OPENAI_IMAGE_MODEL=gpt-image-1-mini
# AI_PHOTOS=true                    # fotos de los platos (necesita clave de OpenAI)
# AI_MONTHLY_BUDGET=1               # tope de gasto en IA al mes, en dólares
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-haiku-4-5
# AI_PROVIDER=openai

# Contraseña para entrar en la app (usuario cualquiera). Recomendable si la abres a internet.
APP_PASSWORD=

# Web del cole y palabra para elegir el PDF correcto
# SCHOOL_MENU_URL=https://www.colegiovillademostoles.cbvm.net/servicios-y-precios/comedor
# SCHOOL_MENU_KEYWORD=BASAL

# Comprobación automática
# CHECK_EVERY_HOURS=6
# CHECK_UNTIL_DAY=7
# AUTO_FETCH=true
